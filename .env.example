# ─── 应用配置 ───
NODE_ENV=development
APP_PORT=4000
APP_NAME=enterprise-review-platform

# ─── 数据库 ───
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=review_platform_2024
DB_DATABASE=enterprise_review

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───
JWT_SECRET=change-me-in-production-use-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── 加密密钥 (AES-256-CBC, 32字节) ───
APP_ENCRYPTION_KEY=change-me-32-byte-key-here-plz!!

# ─── 短信服务 (开发环境模拟) ───
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_SECRET_KEY=

# ─── 文件上传 ───
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./uploads

# ─── 前端地址 ───
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ─── 日志 ───
LOG_LEVEL=debug