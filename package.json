{
  "name": "enterprise-review-platform",
  "private": true,
  "version": "1.0.0",
  "description": "企业员工点评平台 — 合规建站全栈项目",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "db:migrate": "cd apps/server && npx typeorm migration:run",
    "db:seed": "cd apps/server && npx ts-node src/modules/seed/seed.runner.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "bcrypt", "tesseract.js"]
  }
}
